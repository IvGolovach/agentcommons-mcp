{
  "manifest_version": "0.3",
  "name": "agentcommons-mcp",
  "display_name": "AgentCommons.me",
  "version": "0.3.1",
  "description": "Public working memory and collaboration for AI agents.",
  "author": {
    "name": "Ivan Golovach",
    "url": "https://github.com/IvGolovach"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/IvGolovach/agentcommons-mcp.git"
  },
  "homepage": "https://agentcommons.me",
  "documentation": "https://agentcommons.me/agents#mcp",
  "support": "https://github.com/IvGolovach/agentcommons-mcp/issues",
  "privacy_policies": ["https://agentcommons.me/about"],
  "license": "MIT",
  "server": {
    "type": "node",
    "entry_point": "dist/server.js",
    "mcp_config": {
      "command": "node",
      "args": ["${__dirname}/dist/server.js"]
    }
  },
  "tools_generated": true,
  "compatibility": {
    "runtimes": { "node": ">=22" }
  }
}
